# Copy to .env and fill in. Never commit .env.

# From Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Optional: only watch the music bot in these channels (comma-separated IDs).
# Leave blank (recommended) so songs requested from any channel are picked up.
WATCH_CHANNEL_IDS=

# Which bot(s) to watch. Set IDs to be exact (right-click Jockie → Copy User ID;
# add each Jockie instance you use, comma-separated). If blank, any bot whose
# username starts with MUSIC_BOT_NAME_PREFIX is watched.
MUSIC_BOT_IDS=
MUSIC_BOT_NAME_PREFIX=Jockie Music

# Text-command prefixes people use for the music bot, to work out who requested a song.
# Matching ignores case, so "M!p" works too.
MUSIC_COMMAND_PREFIXES=m!
# Commands after the prefix that mean "play a song" (m!skip, m!pause etc. are ignored).
PLAY_COMMANDS=p,play,pn,playnext,playnow,pt,playtop,ps,playskip,search

# Add a ❤️ under each "now playing" message so people can save with one tap.
REACT_TO_NOW_PLAYING=1

# Where to announce each new song. Admins can change this per server with /announce.
#   follow  = post in the text chat of the voice channel the music bot is playing in
#   channel = always post in ANNOUNCE_CHANNEL_ID
#   off     = don't announce
ANNOUNCE_MODE=follow
# Required for "channel" mode; used as a fallback in "follow" mode.
ANNOUNCE_CHANNEL_ID=

# Typing exactly one of these in voice chat or the music channel saves the current song.
LIKE_KEYWORDS=!like,❤️,❤

# DM people a card for every song they save (their DMs become a running list).
# Each person can switch this off for themselves with /dms.
DM_ON_SAVE=1

# Prefix for text commands like p!stats, p!top (change it if another bot already uses p!).
STATS_PREFIX=p!

# Tip link on the help card and p!support (blank hides it).
SUPPORT_URL=https://ko-fi.com/jtatuncsoft/tip
# PandaBot's support server invite (help and invite cards; blank hides it).
SUPPORT_SERVER_URL=https://discord.gg/vvShzeYx5E

DB_PATH=data/jockie_companion.db

# Local debugging only: a file path (e.g. data/samples.jsonl) logs every raw music-bot message.
# Leave blank in production; /musicbot check covers troubleshooting without storing anything.
DEBUG_DUMP_PATH=
